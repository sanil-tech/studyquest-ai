{
  "name": "LessonNotes",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "ID of the parent Lesson"
    },
    "notes_markdown": {
      "type": "string",
      "description": "Student-facing lesson notes in Markdown format"
    },
    "teacher_notes": {
      "type": "string",
      "description": "Teacher-facing supplementary notes"
    },
    "revision_summary": {
      "type": "string",
      "description": "Short revision summary for quick review"
    },
    "voice_script": {
      "type": "string",
      "description": "Narration script for TTS generation"
    },
    "voice_audio_url": {
      "type": "string",
      "description": "URL of generated TTS audio file"
    },
    "notes_image_url": {
      "type": "string",
      "description": "URL of an accompanying notes image/infographic"
    }
  },
  "required": [
    "lesson_id"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}