{
  "name": "ParentChildRelationship",
  "properties": {
    "parent_id": {
      "type": "string",
      "required": true,
      "description": "User ID of the parent account"
    },
    "child_id": {
      "type": "string",
      "required": true,
      "description": "User ID of the student/child account"
    },
    "status": {
      "type": "string",
      "enum": ["active", "pending"],
      "default": "active"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  }
}
