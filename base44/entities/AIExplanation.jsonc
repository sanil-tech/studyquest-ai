{
  "name": "AIExplanation",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "ID of the parent Lesson"
    },
    "concept": {
      "type": "string",
      "description": "The key concept being explained"
    },
    "explanation": {
      "type": "string",
      "description": "AI-generated explanation of the concept"
    }
  },
  "required": [
    "lesson_id",
    "concept"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}