{
  "name": "AIExplanation",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "ID of the parent Lesson"
    },
    "concept": {
      "type": "string",
      "description": "The key concept being explained"
    },
    "explanation": {
      "type": "string",
      "description": "AI-generated explanation of the concept"
    },
    "lesson_version_id": {
      "type": "string",
      "description": "ID of the parent LessonVersion (links to specific content version)"
    },
    "example": {
      "type": "string",
      "description": "Concrete example illustrating the concept"
    },
    "analogy": {
      "type": "string",
      "description": "Child-friendly analogy for the concept"
    },
    "language": {
      "type": "string",
      "default": "ms",
      "description": "Language code e.g. 'ms' (Bahasa Melayu) or 'en' (English)"
    },
    "age_group": {
      "type": "string",
      "description": "Target age group e.g. '6-8', '9-11', '12-17'"
    },
    "created_source": {
      "type": "string",
      "enum": [
        "manual",
        "ai_generated"
      ],
      "default": "manual",
      "description": "Whether this explanation was created manually or by AI"
    },
    "approved_by": {
      "type": "string",
      "description": "User ID of admin who approved this explanation for publishing"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this explanation was approved"
    }
  },
  "required": [
    "lesson_id",
    "concept"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}