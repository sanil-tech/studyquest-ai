{
  "name": "Subtopic",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string",
      "description": "ID of the parent Topic"
    },
    "title": {
      "type": "string",
      "description": "Subtopic title"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display ordering"
    },
    "standard_kandungan": {
      "type": "string",
      "description": "KSSR/KSSM Standard Kandungan code"
    },
    "standard_pembelajaran": {
      "type": "string",
      "description": "KSSR/KSSM Standard Pembelajaran code"
    },
    "tp_code": {
      "type": "string",
      "description": "Tunjuk Performa (TP) code"
    }
  },
  "required": [
    "topic_id",
    "title"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}