{
  "name": "AIInsightReport",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID of the student this report belongs to"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "default": "weekly",
      "description": "Report frequency type"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this report was generated"
    },
    "learning_summary": {
      "type": "string",
      "description": "AI-generated learning summary in Bahasa Melayu"
    },
    "strengths": {
      "type": "string",
      "description": "JSON array of {skill, explanation}"
    },
    "weaknesses": {
      "type": "string",
      "description": "JSON array of {skill, explanation}"
    },
    "recommendations": {
      "type": "string",
      "description": "JSON array of {action, mission}"
    },
    "learning_pattern": {
      "type": "string",
      "description": "JSON: {pattern_type, evidence, preferred_activities[]}"
    },
    "early_warnings": {
      "type": "string",
      "description": "JSON array of {type, message} \u2014 educational observations only"
    },
    "home_activities": {
      "type": "string",
      "description": "JSON array of {name, duration, purpose}"
    },
    "growth_data": {
      "type": "string",
      "description": "JSON array of {month, subjects: [{subject, score}]}"
    },
    "ai_version": {
      "type": "string",
      "default": "suku-v1",
      "description": "AI model version used for this report"
    }
  },
  "required": [
    "student_id",
    "report_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.student_id": {
            "$in": "{{user.data.linked_student_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.student_id": {
            "$in": "{{user.data.linked_student_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": {
            "$in": "{{user.data.linked_student_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}