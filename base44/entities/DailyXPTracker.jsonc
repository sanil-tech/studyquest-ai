{
  "name": "DailyXPTracker",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID of the student"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "The date for this XP record (YYYY-MM-DD)"
    },
    "xp_earned": {
      "type": "number",
      "default": 0,
      "description": "Total XP earned on this date"
    },
    "xp_cap": {
      "type": "number",
      "default": 350,
      "description": "Maximum XP allowed per day"
    },
    "is_capped": {
      "type": "boolean",
      "default": false,
      "description": "Whether the daily XP cap has been reached"
    }
  },
  "required": [
    "student_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.student_id": {
            "$in": "{{user.data.linked_student_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}