{
  "name": "StudentSkillProfile",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID of the student"
    },
    "session_id": {
      "type": "string",
      "description": "ID of the BasicDiagnosticSession that generated this profile"
    },
    "subject": {
      "type": "string",
      "description": "Subject name or module (e.g. Bahasa Melayu, Matematik, Sains, membaca, etc.)"
    },
    "skill": {
      "type": "string",
      "description": "Skill name or Learning Standard ID (e.g. SK_1.1, SP_2.1.3)"
    },
    "sub_skill": {
      "type": "string",
      "description": "Sub-skill name or topic area (e.g. vowels, consonants, KV, fractions)"
    },
    "standard_pembelajaran": {
      "type": "string",
      "description": "KSSR/KSSM Standard Pembelajaran code (e.g. SP 1.1.2)"
    },
    "tp_code": {
      "type": "string",
      "description": "Tahap Penguasaan / Tunjuk Performa code"
    },
    "tp_level": {
      "type": "number",
      "description": "Calculated Tahap Penguasaan level (1 to 6)"
    },
    "ewma_score": {
      "type": "number",
      "default": 0,
      "description": "Exponentially Weighted Moving Average score (0-100)"
    },
    "bloom_weighted_score": {
      "type": "number",
      "default": 0,
      "description": "Bloom cognitive taxonomy weighted score for latest evaluation"
    },
    "mastery_level": {
      "type": "string",
      "enum": [
        "mastered",
        "developing",
        "needs_foundation"
      ],
      "default": "developing",
      "description": "Mastery level: mastered (85-100%), developing (60-84%), needs_foundation (<60%)"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Latest raw score percentage 0-100 for this skill"
    },
    "questions_attempted": {
      "type": "number",
      "default": 0,
      "description": "Cumulative questions attempted for this skill"
    },
    "questions_correct": {
      "type": "number",
      "default": 0,
      "description": "Cumulative correct answers for this skill"
    },
    "last_attempt_id": {
      "type": "string",
      "description": "ID of the latest QuizAttempt evaluated"
    },
    "last_evaluated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of latest EWMA mastery analysis"
    },
    "recommendation": {
      "type": "string",
      "description": "Specific recommendation for this skill"
    }
  },
  "required": [
    "student_id",
    "subject",
    "skill",
    "mastery_level"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.student_id": {
            "$in": "{{user.data.linked_student_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.student_id": {
            "$in": "{{user.data.linked_student_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}