{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "ID of the parent Lesson"
    },
    "topic_id": {
      "type": "string",
      "description": "ID of the parent Topic (for topic-level queries)"
    },
    "front": {
      "type": "string",
      "description": "Front of the flashcard (question/prompt)"
    },
    "back": {
      "type": "string",
      "description": "Back of the flashcard (answer/definition)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display ordering"
    }
  },
  "required": [
    "lesson_id",
    "front",
    "back"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}