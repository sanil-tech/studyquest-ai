{
  "name": "User",
  "type": "object",
  "properties": {
    "app_role": {
      "type": "string",
      "enum": ["student", "parent", "teacher"]
    },
    "nickname": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "child_login_pin": {
      "type": "string"
    },
    "pin_hash": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "is_child_account": {
      "type": "boolean",
      "default": false
    },
    "pin_enabled": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "default": "active"
    }
  },
  "required": ["app_role"]
}
