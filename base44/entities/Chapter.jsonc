{
  "name": "Chapter",
  "type": "object",
  "properties": {
    "textbook_id": {
      "type": "string",
      "description": "ID of the parent Textbook"
    },
    "subject_id": {
      "type": "string",
      "description": "ID of the parent Subject"
    },
    "chapter_number": {
      "type": "number",
      "description": "Chapter sequence number"
    },
    "title": {
      "type": "string",
      "description": "Chapter title"
    },
    "form_level": {
      "type": "string",
      "description": "Education level e.g. Tahun 1, Tingkatan 3"
    }
  },
  "required": [
    "textbook_id",
    "chapter_number",
    "title"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}