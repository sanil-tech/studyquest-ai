{
  "name": "BasicDiagnosticSession",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID of the student who took the diagnostic"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "When the diagnostic was started"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the diagnostic was completed"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed"
      ],
      "default": "in_progress",
      "description": "Current status of the diagnostic session"
    },
    "current_layer": {
      "type": "string",
      "enum": [
        "screening",
        "investigation",
        "completed"
      ],
      "default": "screening",
      "description": "Current adaptive layer"
    },
    "reading_level": {
      "type": "number",
      "default": 0,
      "description": "Reading (Membaca) level achieved (1-6)"
    },
    "writing_level": {
      "type": "number",
      "default": 0,
      "description": "Writing (Menulis) level achieved (1-6)"
    },
    "numeracy_level": {
      "type": "number",
      "default": 0,
      "description": "Numeracy (Mengira) level achieved (1-5)"
    },
    "reading_mastery": {
      "type": "string",
      "enum": [
        "not_assessed",
        "needs_foundation",
        "developing",
        "good",
        "strong"
      ],
      "default": "not_assessed",
      "description": "Mastery rating for reading"
    },
    "writing_mastery": {
      "type": "string",
      "enum": [
        "not_assessed",
        "needs_foundation",
        "developing",
        "good",
        "strong"
      ],
      "default": "not_assessed",
      "description": "Mastery rating for writing"
    },
    "numeracy_mastery": {
      "type": "string",
      "enum": [
        "not_assessed",
        "needs_foundation",
        "developing",
        "good",
        "strong"
      ],
      "default": "not_assessed",
      "description": "Mastery rating for numeracy"
    },
    "overall_level": {
      "type": "string",
      "enum": [
        "foundation",
        "developing",
        "proficient",
        "advanced"
      ],
      "description": "Overall readiness level across all 3M"
    },
    "total_score": {
      "type": "number",
      "default": 0,
      "description": "Overall score percentage 0-100"
    },
    "ai_analysis": {
      "type": "string",
      "description": "JSON string of AI analysis: {strengths, weaknesses, recommended_starting_point, recommended_activities, parent_insight}"
    },
    "recommended_starting_point": {
      "type": "string",
      "description": "AI recommended starting point for learning path"
    },
    "recommended_activities": {
      "type": "string",
      "description": "JSON array of recommended activities [{activity, purpose}]"
    },
    "learning_path_id": {
      "type": "string",
      "description": "ID of the generated LearningPath entity"
    },
    "investigation_skills_json": {
      "type": "string",
      "description": "JSON array of skills that triggered Layer 2 investigation"
    }
  },
  "required": [
    "student_id",
    "date",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.student_id": {
            "$in": "{{user.data.linked_student_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}