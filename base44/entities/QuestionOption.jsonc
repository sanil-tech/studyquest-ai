{
  "name": "QuestionOption",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "description": "ID of the parent QuestionBank record"
    },
    "label": {
      "type": "string",
      "description": "Option label e.g. 'A', 'B', 'C', 'D'"
    },
    "text": {
      "type": "string",
      "description": "The option text"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display ordering"
    }
  },
  "required": [
    "question_id",
    "label",
    "text"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}