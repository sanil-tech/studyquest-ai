{
  "name": "IllustrationPrompt",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "ID of the parent Lesson"
    },
    "prompt_text": {
      "type": "string",
      "description": "AI illustration prompt text"
    },
    "context": {
      "type": "string",
      "description": "Context describing where this illustration is used"
    },
    "generated_image_url": {
      "type": "string",
      "description": "URL of the generated illustration (if generated)"
    }
  },
  "required": [
    "lesson_id",
    "prompt_text"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}