{
  "name": "Level",
  "type": "object",
  "properties": {
    "curriculum_id": {
      "type": "string",
      "description": "ID of the parent Curriculum"
    },
    "education_stage_id": {
      "type": "string",
      "description": "ID of the parent EducationStage"
    },
    "name": {
      "type": "string",
      "description": "Full level name (e.g. Year 1, Form 5, Preschool 5)"
    },
    "short_label": {
      "type": "string",
      "description": "Short display label (e.g. Y1, F5, P5)"
    },
    "age_range": {
      "type": "string",
      "description": "Age range for this level (e.g. '7', '16-17')"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display ordering"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this level is active"
    }
  },
  "required": [
    "curriculum_id",
    "education_stage_id",
    "name"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}