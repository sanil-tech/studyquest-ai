{
  "name": "Year",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Display label e.g. 'Tahun 1', 'Tingkatan 3'"
    },
    "level_type": {
      "type": "string",
      "enum": [
        "primary",
        "secondary"
      ],
      "description": "Primary (KSSR) or Secondary (KSSM)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display ordering"
    }
  },
  "required": [
    "label",
    "level_type"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}