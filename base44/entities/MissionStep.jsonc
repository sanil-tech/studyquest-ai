{
  "name": "MissionStep",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "description": "ID of the parent Mission"
    },
    "step_type": {
      "type": "string",
      "enum": [
        "lesson",
        "quiz",
        "game",
        "assessment",
        "activity"
      ],
      "description": "Type of learning content for this step"
    },
    "reference_id": {
      "type": "string",
      "description": "ID of the referenced content (lesson_id, assessment_id, etc.)"
    },
    "reference_name": {
      "type": "string",
      "description": "Denormalized name for display (e.g. topic name or assessment title)"
    },
    "reference_route": {
      "type": "string",
      "description": "Frontend route to navigate to for this step (e.g. /study/science/topic123)"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sequence order of this step within the mission"
    },
    "xp_reward": {
      "type": "number",
      "default": 10,
      "description": "XP awarded for completing this step"
    },
    "is_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether this step is mandatory for mission completion"
    },
    "is_bonus": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is an optional bonus step"
    }
  },
  "required": [
    "mission_id",
    "step_type"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}